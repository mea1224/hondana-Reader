{
  "name": "hondana-reader",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"wait-on http://127.0.0.1:3210 && cross-env HONDANA_DEV=1 electron .\"",
    "build": "next build",
    "start": "npm run desktop",
    "electron": "electron .",
    "electron:install": "cross-env ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit",
    "dev:web": "next dev --hostname 127.0.0.1 -p 3210",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "node scripts/test-native.mjs",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "pdfium:download": "node scripts/download-pdfium.mjs",
    "dist": "npm run pdfium:download && npm run native:build -- --release && npm run build && electron-builder",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "lucide-react": "^0.468.0",
    "next": "^15.5.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.hondana.reader",
    "productName": "hondana Reader",
    "icon": "electron/icon.png",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "*.node"
        ]
      },
      {
        "from": "resources/pdfium",
        "to": "pdfium",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "mac": {
      "icon": "electron/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.books"
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "asar": true
  },
  "engines": {
    "node": ">=22"
  }
}
